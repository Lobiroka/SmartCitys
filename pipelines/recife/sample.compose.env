# Copie para .env ou para um arquivo privado apontado por ETL_ENV_FILE.
# Preencha com conexões autorizadas. Percent-encode os caracteres da senha na URL.
# Os hosts abaixo são exemplos externos: 127.0.0.1 dentro do container é o próprio container.
MONGODB_URI=mongodb+srv://USUARIO:SENHA@HOST_MONGO/IBGE
DATABASE_URL=postgresql://USUARIO_CARGA:SENHA@HOST_NEON/BANCO?sslmode=require

SPARK_MASTER=local[1]
PYSPARK_SUBMIT_ARGS=--driver-memory 512m --executor-memory 512m pyspark-shell
ETL_CRON=0 3 * * *
ETL_TIMEZONE=America/Recife

# O Compose define PREFECT_API_URL e PYTHON_DOTENV_DISABLED no processo.
# DATABASE_URL_ETL do leitor é fornecida separadamente ao Metrics, nunca neste arquivo.

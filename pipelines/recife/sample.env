# Copie para .env somente no ambiente autorizado e preencha fora do Git.
# Exemplos ilustrativos: não são credenciais válidas. Percent-encode caracteres da senha na URL.
MONGODB_URI=mongodb://USUARIO:SENHA@127.0.0.1:27019/?authSource=admin
DATABASE_URL=postgresql://USUARIO_CARGA:SENHA@127.0.0.1:15435/smartcity_etl_merge
DATABASE_URL_READONLY=postgresql://USUARIO_LEITURA:SENHA@127.0.0.1:15435/smartcity_etl_merge

# Transformação e agendamento; o cron usa o fuso abaixo.
SPARK_MASTER=local[1]
ETL_CRON=0 3 * * *
ETL_TIMEZONE=America/Recife

# Para execução manual sem servidor persistente, deixe PREFECT_API_URL ausente.
# Para painel/runner locais, execute um servidor e configure:
# PREFECT_API_URL=http://127.0.0.1:4200/api

# Em máquinas pequenas, configure também no AMBIENTE DO PROCESSO antes do Python:
# PYSPARK_SUBMIT_ARGS=--driver-memory 512m --executor-memory 512m pyspark-shell
# Para ignorar completamente .env e usar apenas env externo: PYTHON_DOTENV_DISABLED=1

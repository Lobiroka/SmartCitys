{
  "openapi": "3.0.3",
  "info": {
    "title": "SmartCitys API",
    "version": "1.0.1",
    "description": "Contrato das rotas externas do API Gateway. Keycloak emite tokens; login e cadastro não são endpoints desta API. No Demand Service direto, o prefixo interno é /demandas. Gateway limita 200 requisições por IP em 15 minutos."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080",
      "description": "Ambiente local via team:backend"
    },
    {
      "url": "https://api.darkartsbm.com",
      "description": "Integração compartilhada; não executar testes destrutivos"
    }
  ],
  "tags": [
    {
      "name": "Operação"
    },
    {
      "name": "Ocorrências"
    },
    {
      "name": "Gestão"
    },
    {
      "name": "Notificações"
    },
    {
      "name": "Métricas"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/ping": {
      "get": {
        "operationId": "ping",
        "summary": "Verificar o gateway",
        "tags": [
          "Operação"
        ],
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  }
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        },
        "security": []
      }
    },
    "/warmup": {
      "get": {
        "operationId": "warmup",
        "summary": "Iniciar aquecimento dos serviços",
        "tags": [
          "Operação"
        ],
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "warming up"
                      ]
                    }
                  }
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        },
        "description": "Dispara verificações de saúde em segundo plano; não confirma que os serviços estão prontos.",
        "security": []
      }
    },
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "Verificar gateway e dependências",
        "tags": [
          "Operação"
        ],
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          },
          "503": {
            "description": "Uma ou mais dependências indisponíveis",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/demands": {
      "post": {
        "operationId": "createOccurrence",
        "summary": "Criar ocorrência própria",
        "tags": [
          "Ocorrências"
        ],
        "responses": {
          "201": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Occurrence"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          },
          "413": {
            "description": "Corpo maior que 5 MB; resposta do parser pode ser texto/HTML."
          }
        },
        "description": "Perfis cidadao ou gestor. Status inicial ABERTA; proprietário obtido do subject do token.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OccurrenceInput"
              }
            }
          }
        }
      }
    },
    "/demands/my-demands": {
      "get": {
        "operationId": "listOwnOccurrences",
        "summary": "Listar ocorrências próprias",
        "tags": [
          "Ocorrências"
        ],
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OccurrencePage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        },
        "description": "cidadao ou gestor: somente registros do subject autenticado. Ordenação por data_registro decrescente. Apenas page e limit são interpretados pelo servidor; search, status e filtros avançados não são aplicados. Filtros do cidadão são locais no app.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ]
      }
    },
    "/demands/feed": {
      "get": {
        "operationId": "listFeed",
        "summary": "Listar feed geral autenticado",
        "tags": [
          "Ocorrências"
        ],
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OccurrencePage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        },
        "description": "cidadao ou gestor. Não é uma rota pública. Ordenação por data_registro decrescente. Apenas page e limit são interpretados pelo servidor; search, status e filtros avançados não são aplicados. Filtros do cidadão são locais no app.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ]
      }
    },
    "/demands/gestor": {
      "get": {
        "operationId": "listManagerOccurrences",
        "summary": "Listar todas as ocorrências para gestão",
        "tags": [
          "Gestão"
        ],
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OccurrencePage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        },
        "description": "Exige perfil gestor. Ordenação por data_registro decrescente. Apenas page e limit são interpretados pelo servidor; search, status e filtros avançados não são aplicados. Filtros do cidadão são locais no app.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ]
      }
    },
    "/demands/{id}": {
      "get": {
        "operationId": "getOwnOccurrence",
        "summary": "Consultar detalhes de ocorrência própria",

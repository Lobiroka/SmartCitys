  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Access token Keycloak com issuer/audience válidos e perfil cidadao ou gestor. O app usa Authorization Code com PKCE; nunca envie client_secret."
      }
    },
    "schemas": {
      "Category": {
        "type": "string",
        "enum": [
          "ILUMINACAO_PUBLICA",
          "MANUTENCAO_DE_VIAS",
          "SANEAMENTO",
          "COLETA_DE_LIXO",
          "FISCALIZACAO",
          "SEGURANCA",
          "SINALIZACAO_DE_TRANSITO",
          "OUTROS_EMPECILHOS"
        ]
      },
      "Region": {
        "type": "string",
        "enum": [
          "REGIAO_METROPOLITANA_DO_RECIFE",
          "ZONA_DA_MATA",
          "AGRESTE",
          "SERTAO",
          "OUTRA"
        ]
      },
      "Status": {
        "type": "string",
        "enum": [
          "ABERTA",
          "EM_ANALISE",
          "RESOLVIDA"
        ]
      },
      "Priority": {
        "type": "string",
        "enum": [
          "ALTA",
          "MEDIA",
          "BAIXA"
        ]
      },
      "Image": {
        "type": "object",
        "properties": {
          "id_imagem": {
            "type": "integer"
          },
          "caminho_file": {
            "type": "string",
            "description": "Data URI JPEG em base64 no fluxo Android atual."
          },
          "data_upload": {
            "type": "string",
            "format": "date-time"
          },
          "denuncia_id": {
            "type": "integer"
          }
        },
        "required": [
          "id_imagem",
          "caminho_file",
          "data_upload",
          "denuncia_id"
        ]
      },
      "History": {
        "type": "object",
        "properties": {
          "id_historico": {
            "type": "integer"
          },
          "data_abertura": {
            "type": "string",
            "format": "date-time"
          },
          "data_alteracao": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "prioridade": {
            "$ref": "#/components/schemas/Priority"
          },
          "denuncia_id": {
            "type": "integer"
          },
          "gestor_id": {
            "type": "integer"
          }
        }
      },
      "OccurrenceInput": {
        "type": "object",
        "properties": {
          "titulo": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1
          },
          "categoria": {
            "$ref": "#/components/schemas/Category"
          },
          "regiao": {
            "$ref": "#/components/schemas/Region"
          },
          "descricao": {
            "type": "string",
            "minLength": 1
          },
          "endereco": {
            "type": "string",
            "nullable": true
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90,
            "nullable": true
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180,
            "nullable": true
          },
          "prioridade": {
            "$ref": "#/components/schemas/Priority"
          },
          "imagens": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Fotos em data URI base64. Corpo completo limitado a 5 MB no Demand Service."
          }
        },
        "required": [
          "titulo",
          "categoria",
          "regiao",
          "descricao"
        ],
        "description": "Informe endereço não vazio OU latitude e longitude juntas. PATCH requer os mesmos campos obrigatórios do POST; substitui imagens (omitidas resultam em remoção das fotos). Prioridade omitida no POST assume MEDIA."
      },
      "OccurrenceRecord": {
        "type": "object",
        "properties": {
          "titulo": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1
          },
          "categoria": {
            "$ref": "#/components/schemas/Category"
          },
          "regiao": {
            "$ref": "#/components/schemas/Region"
          },
          "descricao": {
            "type": "string",
            "minLength": 1
          },
          "endereco": {
            "type": "string",
            "nullable": true
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90,
            "nullable": true
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180,
            "nullable": true
          },
          "prioridade": {
            "$ref": "#/components/schemas/Priority"
          },
          "id_denuncia": {
            "type": "integer"
          },
          "cidadao_id": {
            "type": "integer"
          },
          "email_solicitante": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "data_registro": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id_denuncia",
          "titulo",
          "categoria",
          "regiao",
          "descricao",
          "status",
          "prioridade",
          "data_registro",
          "cidadao_id"
        ]
      },
      "Occurrence": {
        "allOf": [
          {
            "$ref": "#/components/schemas/OccurrenceRecord"
          },
          {
            "type": "object",
            "properties": {
              "imagens": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Image"
                }
              },
              "historicos": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/History"
                },
                "description": "Presente nas consultas de detalhes."
              }
            },
            "required": [
              "imagens"
            ]
          }
        ]
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "totalPages": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "page",
          "limit",
          "total",
          "totalPages"
        ]
      },
      "OccurrencePage": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Occurrence"
            }
          },
          "pagination": {
            "$ref": "#/components/schemas/Pagination"
          }
        },
        "required": [
          "data",
          "pagination"
        ]
      },
      "ChangeResult": {
        "type": "object",
        "properties": {
          "denuncia": {
            "$ref": "#/components/schemas/OccurrenceRecord"
          },
          "historico": {
            "$ref": "#/components/schemas/History"
          }
        },
        "required": [
          "denuncia",
          "historico"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "PushDevice": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^(ExponentPushToken|ExpoPushToken)\\[[A-Za-z0-9_-]{1,128}\\]$",
            "example": "ExpoPushToken[exemplo_123]"
          }
        },
        "required": [
          "token"
        ]
      },
      "Metrics": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "byCategory": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "byRegion": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "byStatus": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "total",
          "byCategory",
          "byRegion",
          "byStatus",
          "updatedAt"
        ]
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "gateway": {
            "type": "string",
            "enum": [
              "api-gateway"
            ]
          },
          "services": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "ok",
                    "error"
                  ]
                },
                "code": {
                  "type": "integer"
                }
              },
              "required": [
                "name",
                "status",
                "code"
              ]
            }
          }
        },
        "required": [
          "status",
          "gateway",
          "services"
        ]
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Entrada inválida ou alteração não permitida",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Token ausente, inválido ou expirado",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Perfil sem permissão",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Ocorrência inexistente ou não pertence ao solicitante",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "ServerError": {
        "description": "Falha interna",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "TooManyRequests": {
        "description": "Limite de 200 requisições por IP em 15 minutos atingido; resposta de texto do gateway."
      }
    }
  }
}

          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        },
        "description": "Exige gestor. Rejeita o valor atual com 400. Registra a alteração no histórico. Aceita texto sem diferenciar maiúsculas ou acentos. Não envia push de status.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "prioridade": {
                    "$ref": "#/components/schemas/Priority"
                  }
                },
                "required": [
